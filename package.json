{
  "name": "gujarat-agmarknet-mcp",
  "version": "1.0.0",
  "description": "AI-Powered Gujarat Agricultural Market Intelligence MCP Server (AGMARKNET)",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "mcp": "tsx src/server/mcpServer.ts",
    "rest": "tsx src/server/restServer.ts",
    "initial-import": "tsx scripts/initialImport.ts",
    "clear-data": "tsx scripts/clearData.ts",
    "sync": "tsx scripts/sync.ts",
    "import-data": "tsx scripts/importData.ts",
    "import-historical": "tsx scripts/importHistoricalData.ts",
    "backfill": "tsx scripts/backfill.ts",
    "rebuild-embeddings": "tsx scripts/rebuildEmbeddings.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": ["mcp", "agmarknet", "gujarat", "agriculture", "rag"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^7.1.0",
    "mongodb": "^6.10.0",
    "node-cron": "^3.0.3",
    "playwright": "^1.48.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
