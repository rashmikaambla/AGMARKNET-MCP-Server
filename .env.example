# ===================================================================
# Gujarat AGMARKNET MCP Server - Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ===================================================================

NODE_ENV=development
PORT=3000

# ---------------- MongoDB ----------------
MONGODB_URI=mongodb://127.0.0.1:27017/gujarat_agmarknet
MONGODB_DATABASE=gujarat_agmarknet

# ---------------- AGMARKNET source ----------------
AGMARKNET_URL=https://agmarknet.gov.in/daily-price-and-arrival-report
AGMARKNET_PRICE_ARRIVALS=Price
AGMARKNET_STATE=Gujarat
AGMARKNET_COMMODITY_GROUP=Cereals
AGMARKNET_COMMODITY=Wheat
AGMARKNET_VARIETY=All Varieties
AGMARKNET_GRADE=FAQ
AGMARKNET_DISTRICT=All Districts
AGMARKNET_MARKET=All Markets
AGMARKNET_TIMEOUT_MS=60000
# Screenshot shows more than 1,000 pages, so 500 is not enough.
AGMARKNET_MAX_PAGES=5000

# ---------------- Historical import ----------------
# One-time import only. It NEVER deletes older records.
INITIAL_HISTORY_YEARS=1

# ---------------- Scheduler ----------------
# 21:00 = 9:00 PM local server time.
DATA_SYNC_CRON=0 21 * * *
# Production uses Windows Task Scheduler + `npm run sync`.
# Set true only if you intentionally want an in-process cron as well.
ENABLE_INTERNAL_SCHEDULER=false

# ---------------- Admin / security ----------------
ADMIN_API_KEY=change-me-to-a-long-random-string

# ---------------- Embeddings ----------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-embedding-384
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# ---------------- Vector search ----------------
VECTOR_SEARCH_MODE=local
MONGODB_VECTOR_INDEX=rag_vector_index

# ---------------- Logging ----------------
LOG_LEVEL=info

# ---------------- Development sample data ----------------
ALLOW_SAMPLE_DATA=true
